FROM node:22-alpine

WORKDIR /app

# Install deps first so layer is cached when only source changes.
COPY package.json package-lock.json ./
RUN npm ci

# Copy source. With bind mounts these get shadowed by host files at run time.
COPY . .

EXPOSE 3000

# CMD runs at container start, not build. Dev server supports hot reload.
CMD ["npm", "start"]
